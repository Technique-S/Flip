{
  "$id": "urn:flip:schema:circuit-identity:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chainId": {
      "const": 196,
      "title": "Chainid",
      "type": "integer"
    },
    "circuitId": {
      "maxLength": 78,
      "pattern": "^(0|[1-9][0-9]*)$",
      "title": "Circuitid",
      "type": "string"
    },
    "processor": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "title": "Processor",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "chainId",
    "processor",
    "circuitId"
  ],
  "title": "CircuitIdentity",
  "type": "object"
}
