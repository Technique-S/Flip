        },
        "parent": {
          "$ref": "#/$defs/CircuitIdentity"
        }
      },
      "required": [
        "parent",
        "child"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Edit": {
      "additionalProperties": false,
      "properties": {
