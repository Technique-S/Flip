    "ImportResult": {
      "additionalProperties": false,
      "properties": {
        "circuits": {
          "items": {
            "$ref": "#/$defs/CircuitBytes"
          },
          "maxItems": 1251,
          "minItems": 1,
          "title": "Circuits",
          "type": "array"
        },
        "integrity": {
          "$ref": "#/$defs/Integrity"
        },
        "kind": {
          "const": "CIRCUIT_IMPORT",
          "title": "Kind",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/Manifest"
