{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "number": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "number",
        "hash"
      ],
      "title": "Block",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "discriminator": {
              "mapping": {
                "NAND": "#/$defs/NandComponent",
                "REF": "#/$defs/RefComponent"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RefComponent"
              },
              {
                "$ref": "#/$defs/NandComponent"
              }
            ]
          },
          "maxItems": 5000,
          "title": "Components",
          "type": "array"
        },
        "nIn": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Nin",
          "type": "integer"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PinSource"
          },
          "maxItems": 65536,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "nIn",
        "components",
        "outputs"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CandidateAction": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Actionid",
          "type": "string"
        },
        "classification": {
          "const": "CANDIDATE_ACTION",
          "default": "CANDIDATE_ACTION",
          "title": "Classification",
          "type": "string"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/Edit"
          },
          "maxItems": 10000,
          "title": "Edits",
          "type": "array"
        },
        "proposedRevision": {
          "$ref": "#/$defs/VerificationRequest"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "actionId",
        "title",
        "reasoning",
        "edits",
        "proposedRevision"
      ],
      "title": "CandidateAction",
      "type": "object"
    },
    "CircuitBytes": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/CircuitIdentity"
        },
        "netlist": {
          "maxLength": 2000002,
          "pattern": "^0x(?:[0-9a-f]{2})*$",
          "title": "Netlist",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "netlist"
      ],
      "title": "CircuitBytes",
      "type": "object"
    },
    "CircuitIdentity": {
      "additionalProperties": false,
      "properties": {
        "chainId": {
          "const": 196,
          "title": "Chainid",
          "type": "integer"
        },
        "circuitId": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Circuitid",
          "type": "string"
        },
        "processor": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Processor",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "chainId",
        "processor",
        "circuitId"
      ],
      "title": "CircuitIdentity",
      "type": "object"
    },
    "CodeIdentity": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Address",
          "type": "string"
        },
        "codeHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Codehash",
          "type": "string"
        }
      },
      "required": [
        "address",
        "codeHash"
      ],
      "title": "CodeIdentity",
      "type": "object"
    },
    "ComparisonPlan": {
      "additionalProperties": false,
      "properties": {
        "inputMap": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Inputmap",
          "type": "array"
        },
        "intent": {
          "enum": [
            "TRUSTED_REFERENCE",
            "UNDECLARED"
          ],
          "title": "Intent",
          "type": "string"
        },
        "kind": {
          "const": "PAIRWISE_EQUIVALENCE",
          "title": "Kind",
          "type": "string"
        },
        "outputMap": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 65536,
          "minItems": 1,
          "title": "Outputmap",
          "type": "array"
        },
        "referenceAlias": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Referencealias",
          "type": "string"
        },
        "trustAssertion": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trustassertion"
        }
      },
      "required": [
        "kind",
        "referenceAlias",
        "intent",
        "trustAssertion",
        "inputMap",
        "outputMap"
      ],
      "title": "ComparisonPlan",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "const": "RELEVANT_CONNECTION",
          "default": "RELEVANT_CONNECTION",
          "title": "Classification",
          "type": "string"
        },
        "connectionRef": {
          "maxLength": 2200,
          "title": "Connectionref",
          "type": "string"
        },
        "destination": {
          "maxLength": 2200,
          "title": "Destination",
          "type": "string"
        },
        "elementIndex": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elementindex"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CircuitIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inputPin": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputpin"
        },
        "instanceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instanceid"
        },
        "kind": {
          "enum": [
            "NAND",
            "REF_INPUT",
            "REF_OUTPUT",
            "OUTPUT_MAP"
          ],
          "title": "Kind",
          "type": "string"
        },
        "netlistHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Netlisthash",
          "type": "string"
        },
        "outputPin": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outputpin"
        },
        "path": {
          "maxLength": 2048,
          "title": "Path",
          "type": "string"
        },
        "projectPin": {
          "anyOf": [
            {
              "$ref": "#/$defs/PinSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "side": {
          "enum": [
            "reference",
            "candidate"
          ],
          "title": "Side",
          "type": "string"
        },
        "sourceSignal": {
          "title": "Sourcesignal",
          "type": "integer"
        }
      },
      "required": [
        "side",
        "path",
        "connectionRef",
        "kind",
        "sourceSignal",
        "destination",
        "netlistHash"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Actionid",
          "type": "string"
        },
        "classification": {
          "enum": [
            "VERIFIED_CORRECTION",
            "UNKNOWN",
            "CANDIDATE_ACTION"
          ],
          "title": "Classification",
          "type": "string"
        },
        "comparison": {
          "additionalProperties": true,
          "title": "Comparison",
          "type": "object"
        },
        "originalProjectHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Originalprojecthash",
          "type": "string"
        },
        "revalidation": {
          "const": "PINNED_IDENTITIES_HASHES_AND_CLOSURE_REPLAYED",
          "title": "Revalidation",
          "type": "string"
        },
        "revisedProjectHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Revisedprojecthash",
          "type": "string"
        },
        "scope": {
          "const": "EXACT_STATELESS_SELECTED_REFERENCE_HISTORICAL",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "classification",
        "actionId",
        "originalProjectHash",
        "revisedProjectHash",
        "comparison",
        "revalidation",
        "scope"
      ],
      "title": "Correction",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "child": {
