          "title": "Factorysealed",
          "type": "boolean"
        },
        "processorCodeHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Processorcodehash",
          "type": "string"
        }
      },
      "required": [
        "factory",
        "factoryImplementationSlot",
        "factoryImplementation",
        "factorySealed",
        "beacon",
        "beaconImplementation",
        "processorCodeHash"
      ],
      "title": "Environment",
      "type": "object"
