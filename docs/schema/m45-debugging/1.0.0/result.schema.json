        "manifestHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Manifesthash",
          "type": "string"
        },
        "pinning": {
          "const": "NUMBER_WITH_HEADER_RECHECK",
          "title": "Pinning",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "trust": {
          "const": "SINGLE_RPC_OBSERVATION",
          "title": "Trust",
          "type": "string"
        }
