{
  "$defs": {
    "BitVector": {
      "additionalProperties": false,
      "description": "Text character i is vector bit i, packed into byte i//8 at bit i%8.",
      "properties": {
        "bits": {
          "maxLength": 65536,
          "pattern": "^[01]*$",
          "title": "Bits",
          "type": "string"
        },
        "encoding": {
          "const": "tap02-lsb0-v1",
          "title": "Encoding",
          "type": "string"
        },
        "width": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "encoding",
        "width",
        "bits"
      ],
      "title": "BitVector",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "number": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "number",
        "hash"
      ],
      "title": "Block",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "discriminator": {
              "mapping": {
                "NAND": "#/$defs/NandComponent",
                "REF": "#/$defs/RefComponent"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RefComponent"
              },
              {
                "$ref": "#/$defs/NandComponent"
              }
            ]
          },
          "maxItems": 5000,
          "title": "Components",
          "type": "array"
        },
        "nIn": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Nin",
          "type": "integer"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PinSource"
          },
          "maxItems": 65536,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "nIn",
        "components",
        "outputs"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Catalog": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "LIBRARY_CATALOG",
          "default": "LIBRARY_CATALOG",
          "title": "Kind",
          "type": "string"
        },
        "overlay": {
          "$ref": "#/$defs/Overlay"
        },
        "records": {
          "default": [],
