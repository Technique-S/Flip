    "ComparisonPlan": {
      "additionalProperties": false,
      "properties": {
        "inputMap": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Inputmap",
          "type": "array"
        },
        "intent": {
          "enum": [
            "TRUSTED_REFERENCE",
            "UNDECLARED"
          ],
          "title": "Intent",
          "type": "string"
        },
        "kind": {
          "const": "PAIRWISE_EQUIVALENCE",
          "title": "Kind",
          "type": "string"
        },
        "outputMap": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 65536,
          "minItems": 1,
          "title": "Outputmap",
          "type": "array"
        },
        "referenceAlias": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Referencealias",
          "type": "string"
        },
        "trustAssertion": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trustassertion"
        }
      },
      "required": [
        "kind",
        "referenceAlias",
        "intent",
        "trustAssertion",
        "inputMap",
        "outputMap"
      ],
      "title": "ComparisonPlan",
      "type": "object"
    },
