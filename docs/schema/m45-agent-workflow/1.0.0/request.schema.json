          "maxItems": 1000,
          "title": "Records",
          "type": "array"
        },
        "schemaVersion": {
          "const": "m45-library-1.1.0",
          "default": "m45-library-1.1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "title": "Catalog",
      "type": "object"
    },
    "CircuitBytes": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/CircuitIdentity"
        },
        "netlist": {
          "maxLength": 2000002,
          "pattern": "^0x(?:[0-9a-f]{2})*$",
          "title": "Netlist",
          "type": "string"
