{
  "$defs": {
    "BitVector": {
      "additionalProperties": false,
      "description": "Text character i is vector bit i, packed into byte i//8 at bit i%8.",
      "properties": {
        "bits": {
          "maxLength": 65536,
          "pattern": "^[01]*$",
          "title": "Bits",
          "type": "string"
        },
        "encoding": {
          "const": "tap02-lsb0-v1",
          "title": "Encoding",
          "type": "string"
        },
        "width": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "encoding",
        "width",
        "bits"
      ],
      "title": "BitVector",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "hash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "number": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Number",
          "type": "string"
        }
      },
      "required": [
        "number",
        "hash"
      ],
      "title": "Block",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "discriminator": {
              "mapping": {
                "NAND": "#/$defs/NandComponent",
                "REF": "#/$defs/RefComponent"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RefComponent"
              },
              {
                "$ref": "#/$defs/NandComponent"
              }
            ]
          },
          "maxItems": 5000,
          "title": "Components",
          "type": "array"
        },
        "nIn": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Nin",
          "type": "integer"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/PinSource"
          },
          "maxItems": 65536,
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "nIn",
        "components",
        "outputs"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CircuitBytes": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/CircuitIdentity"
        },
        "netlist": {
          "maxLength": 2000002,
          "pattern": "^0x(?:[0-9a-f]{2})*$",
          "title": "Netlist",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "netlist"
      ],
      "title": "CircuitBytes",
      "type": "object"
    },
    "CircuitIdentity": {
      "additionalProperties": false,
      "properties": {
        "chainId": {
          "const": 196,
          "title": "Chainid",
          "type": "integer"
        },
        "circuitId": {
          "maxLength": 78,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Circuitid",
          "type": "string"
        },
        "processor": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Processor",
          "type": "string"
        },
        "schemaVersion": {
          "const": "1.0.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "chainId",
        "processor",
        "circuitId"
      ],
      "title": "CircuitIdentity",
      "type": "object"
    },
    "CodeIdentity": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Address",
          "type": "string"
        },
        "codeHash": {
          "pattern": "^0x[0-9a-f]{64}$",
          "title": "Codehash",
          "type": "string"
        }
      },
      "required": [
        "address",
        "codeHash"
      ],
      "title": "CodeIdentity",
      "type": "object"
    },
    "ComparisonPlan": {
      "additionalProperties": false,
      "properties": {
        "inputMap": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 65536,
          "title": "Inputmap",
          "type": "array"
        },
        "intent": {
          "enum": [
            "TRUSTED_REFERENCE",
            "UNDECLARED"
          ],
          "title": "Intent",
          "type": "string"
        },
        "kind": {
          "const": "PAIRWISE_EQUIVALENCE",
          "title": "Kind",
          "type": "string"
        },
        "outputMap": {
          "items": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 65536,
          "minItems": 1,
          "title": "Outputmap",
          "type": "array"
        },
        "referenceAlias": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Referencealias",
          "type": "string"
        },
        "trustAssertion": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trustassertion"
        }
      },
      "required": [
        "kind",
        "referenceAlias",
        "intent",
        "trustAssertion",
        "inputMap",
        "outputMap"
      ],
      "title": "ComparisonPlan",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "child": {
          "$ref": "#/$defs/CircuitIdentity"
        },
        "parent": {
          "$ref": "#/$defs/CircuitIdentity"
        }
      },
      "required": [
        "parent",
        "child"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Edit": {
      "additionalProperties": false,
